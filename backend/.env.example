# Salin ke .env dan sesuaikan. Jangan commit file .env asli.

APP_ENV=local
APP_PORT=8000
APP_URL=http://localhost:8000

# Database
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bilcode_projectpulse
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Auth (JWT / Sanctum / Passport — sesuaikan dengan yang dipakai)
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# ML — LLM API untuk fitur AI task breakdown
LLM_PROVIDER=openai            # openai | gemini | huggingface
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=10000
